<!DOCTYPE html>
<html>
<head>
    <title>회원 관리</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container" style="margin-top: 50px;">
        <h2>👥 가입된 회원 목록</h2>
        <a href="/admin" class="btn btn-outline">← 뒤로가기</a>
        
        <table class="board-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>아이디</th>
                    <th>닉네임</th>
                    <th>권한</th>
                    <th>가입일</th>
                    <th>관리</th>
                </tr>
            </thead>
            <tbody>
                <% users.forEach(user => { %>
                <tr>
                    <td><%= user.id %></td>
                    <td><%= user.username %></td>
                    <td><%= user.nickname %></td>
                    <td>
                        <% if(user.is_admin) { %>
                            <span style="color:red; font-weight:bold;">관리자</span>
                        <% } else { %>
                            일반
                        <% } %>
                    </td>
                    <td><%= new Date(user.created_at).toLocaleDateString() %></td>
                    <td>
                        <% if(!user.is_admin) { %>
                            <button onclick="if(confirm('정말 추방하시겠습니까?')) location.href='/admin/users/delete/<%= user.id %>'" class="btn btn-danger" style="padding: 2px 10px; font-size: 0.8rem;">추방</button>
                        <% } %>
                    </td>
                </tr>
                <% }); %>
            </tbody>
        </table>
    </div>
</body>
</html>