<!DOCTYPE html>
<html>
<head>
    <title>공지 관리</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container" style="margin-top: 50px;">
        <h2>📢 공지사항 관리</h2>
        <div style="display: flex; justify-content: space-between; margin-bottom: 10px;">
            <a href="/admin" class="btn btn-outline">← 뒤로가기</a>
            <a href="/board/write" class="btn btn-primary">새 공지 쓰기</a>
        </div>
        
        <table class="board-table">
            <thead>
                <tr>
                    <th>번호</th>
                    <th>제목</th>
                    <th>작성자</th>
                    <th>조회수</th>
                    <th>관리</th>
                </tr>
            </thead>
            <tbody>
                <% notices.forEach(notice => { %>
                <tr class="notice-row">
                    <td><%= notice.id %></td>
                    <td><a href="/board/view/<%= notice.id %>"><%= notice.title %></a></td>
                    <td><%= notice.nickname %></td>
                    <td><%= notice.views %></td>
                    <td>
                        <button onclick="location.href='/board/edit/<%= notice.id %>'" class="btn btn-outline">수정</button>
                        <button onclick="if(confirm('삭제합니까?')) location.href='/board/delete/<%= notice.id %>'" class="btn btn-danger">삭제</button>
                    </td>
                </tr>
                <% }); %>
            </tbody>
        </table>
    </div>
</body>
</html>