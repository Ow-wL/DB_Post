<!DOCTYPE html>
<html>
<head>
    <title>관리자 페이지</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <nav class="navbar">
        <div class="inner">
            <a href="/admin" class="logo">ADMIN PAGE</a>
            <div class="nav-links">
                <a href="/">사이트 홈</a>
                <a href="/auth/logout">로그아웃</a>
            </div>
        </div>
    </nav>

    <div class="container">
        <h2>📊 관리자 대시보드</h2>
        <div style="display: flex; gap: 20px; margin-top: 20px;">
            <div style="flex: 1; padding: 20px; background: #e0f2fe; border-radius: 8px;">
                <h3>총 회원 수</h3>
                <p style="font-size: 2rem; font-weight: bold;"><%= stats.users %>명</p>
                <a href="/admin/users" class="btn btn-primary">회원 관리 ></a>
            </div>
            <div style="flex: 1; padding: 20px; background: #dcfce7; border-radius: 8px;">
                <h3>총 게시글</h3>
                <p style="font-size: 2rem; font-weight: bold;"><%= stats.posts %>개</p>
                <a href="/board" class="btn btn-primary">게시판 이동 ></a>
            </div>
            <div style="flex: 1; padding: 20px; background: #fee2e2; border-radius: 8px;">
                <h3>등록된 공지</h3>
                <p style="font-size: 2rem; font-weight: bold;"><%= stats.notices %>개</p>
                <a href="/admin/notices" class="btn btn-primary">공지 관리 ></a>
            </div>
        </div>
    </div>
</body>
</html>